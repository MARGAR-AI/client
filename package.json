{
  "name": "ai-provider-assignment",
  "version": "1.0.0",
  "description": "Automated planned assignment of AI providers on projects",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client-install": "npm install --prefix client",
    "dev:full": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build && cd ..",
    "vercel-build": "npm run build"
  },
  "keywords": [
    "ai",
    "assignment",
    "project management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.5.2",
    "csv-writer": "^1.6.0",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "fs": "^0.0.1-security",
    "node-cache": "^5.1.2",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.9"
  }
}
